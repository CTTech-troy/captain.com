{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run images && npm run typecheck && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "test:contact": "node --test server/contact.test.mjs",
    "preview": "node scripts/preview.mjs",
